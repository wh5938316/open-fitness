{
  "name": "@openfitness/server",
  "version": "0.1.0",
  "private": true,
  "description": "A headless, self-hostable fitness service for MCP agents and native applications.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.0.6",
  "scripts": {
    "dev": "pnpm build:client && wrangler dev --port 8787",
    "build:client": "node scripts/build-client.mjs",
    "build": "pnpm build:client && wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "pnpm build:client && wrangler deploy",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "owner:recover": "node scripts/recover-owner.mjs"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.3",
    "@modelcontextprotocol/server": "^2.3.1",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "hono": "^4.13.13",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.6",
    "@cloudflare/workers-types": "^5.20261019.1",
    "@modelcontextprotocol/client": "^2.3.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.0.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.151.3"
  }
}
