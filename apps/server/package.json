{
  "name": "@openfitness/server",
  "version": "0.1.0",
  "private": true,
  "description": "A headless, self-hostable fitness service for MCP agents and native applications.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.0.6",
  "scripts": {
    "dev": "pnpm build:client && wrangler dev --port 8787",
    "build:client": "node scripts/build-client.mjs",
    "build": "pnpm build:client && wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node scripts/check-migration.mjs && node scripts/check-catalog.mjs",
    "catalog:build": "node scripts/catalog-build.mjs",
    "catalog:seed": "node scripts/catalog-seed.mjs --local",
    "catalog:seed:remote": "node scripts/catalog-seed.mjs --remote",
    "musclemap:svg": "node scripts/musclemap-svg.mjs",
    "test:e2e": "playwright test",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "pnpm build:client && wrangler deploy",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "user:recover": "node scripts/recover-user.mjs"
  },
  "dependencies": {
    "@clerk/backend": "^3.25.0",
    "@clerk/clerk-js": "^6.39.1",
    "@cloudflare/workers-oauth-provider": "^1.2.3",
    "@modelcontextprotocol/server": "^2.3.1",
    "hono": "^4.13.13",
    "tinybase": "^10.0.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.6",
    "@cloudflare/workers-types": "^5.20261019.1",
    "@modelcontextprotocol/client": "^2.3.1",
    "@musclemap/assets": "1.1.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.0.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.151.3"
  }
}
